---
interface LinkItem {
  label: string;
  href: string;
}

interface Profile {
  name: string;
  email: string;
  resumeHref?: string;
}

interface Props {
  profile: Profile;
  links: LinkItem[];
}

const { profile, links } = Astro.props;

function getLinkMeta(link: LinkItem) {
  const label = link.label.toLowerCase();

  if (label.includes("linkedin")) {
    return {
      variant: "linkedin",
      shortLabel: "LinkedIn",
      icon: "linkedin"
    };
  }

  if (label.includes("github")) {
    return {
      variant: "github",
      shortLabel: "GitHub",
      icon: "github"
    };
  }

  return {
    variant: "resume",
    shortLabel: "Resume",
    icon: "resume"
  };
}

const actionLinks = [
  {
    label: "Email",
    href: `mailto:${profile.email}`,
    variant: "email",
    shortLabel: "Email",
    icon: "email"
  },
  ...links
    .filter((link) => !link.label.toLowerCase().includes("resume"))
    .map((link) => ({ ...link, ...getLinkMeta(link) })),
  ...(profile.resumeHref
    ? [
        {
          label: "Resume",
          href: profile.resumeHref,
          variant: "resume",
          shortLabel: "Resume",
          icon: "resume"
        }
      ]
    : [])
];
---

<section class="contact-panel">
  <div>
    <p class="eyebrow">Contact</p>
    <h2 data-edit-key="contact.panelTitle">Let&apos;s make the next step easy.</h2>
    <p data-edit-key="contact.panelSummary">Reach out for tutoring, portfolio questions, collaborations, or opportunities.</p>
    <p class="contact-email">Tutoring email: <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
  </div>
  <div class="contact-actions">
    <div class="social-links" aria-label="Contact links">
      {actionLinks.map((link) => {
        return (
          <a
            class={`social-link-card ${link.variant}`}
            href={link.href}
            aria-label={link.shortLabel}
            title={link.shortLabel}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            <span class="social-link-icon" aria-hidden="true">
              {link.icon === "email" && (
                <svg viewBox="0 0 24 24" role="img">
                  <rect x="4" y="6" width="16" height="12" rx="2.5"></rect>
                  <path d="m5.8 8.1 6.2 4.8 6.2-4.8" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" role="img">
                  <rect x="4.5" y="4.5" width="15" height="15" rx="4"></rect>
                  <circle cx="8.3" cy="9" r="1.15" fill="currentColor"></circle>
                  <path d="M7.25 11.15V16.8" />
                  <path d="M11.1 16.8V12.75c0-1.15.78-1.85 1.72-1.85 1.04 0 1.68.67 1.68 1.92v3.98" />
                  <path d="M11.1 13.4V11.15" />
                </svg>
              )}
              {link.icon === "github" && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M12 4.7c-4.08 0-7.4 3.3-7.4 7.37 0 3.25 2.11 6 5.03 6.98.37.07.5-.16.5-.36 0-.18-.01-.78-.01-1.41-2.05.44-2.48-.87-2.48-.87-.33-.85-.82-1.08-.82-1.08-.67-.46.05-.45.05-.45.74.05 1.14.76 1.14.76.66 1.12 1.72.8 2.14.61.07-.47.26-.8.47-.98-1.64-.18-3.37-.82-3.37-3.65 0-.8.29-1.45.76-1.97-.08-.19-.33-.93.07-1.93 0 0 .62-.2 2.03.75a7.17 7.17 0 0 1 3.7 0c1.41-.95 2.03-.75 2.03-.75.4 1 .15 1.74.08 1.93.47.52.76 1.17.76 1.97 0 2.84-1.73 3.47-3.38 3.65.27.23.5.68.5 1.38 0 1-.01 1.8-.01 2.05 0 .2.13.44.5.36A7.39 7.39 0 0 0 19.4 12c0-4.07-3.32-7.37-7.4-7.37Z" />
                </svg>
              )}
              {link.icon === "resume" && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M8 4.75h6.55L18 8.2v10.05a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 7 18.25v-12A1.5 1.5 0 0 1 8.5 4.75Z" />
                  <path d="M14.55 4.75V8.2H18" />
                  <path d="M9.6 11.15h4.8" />
                  <path d="M9.6 13.8h4.8" />
                  <path d="M9.6 16.45h3.35" />
                </svg>
              )}
            </span>
            <span class="social-link-label">{link.shortLabel}</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
