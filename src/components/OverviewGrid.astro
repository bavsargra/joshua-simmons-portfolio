---
interface OverviewItem {
  title: string;
  summary: string;
  href: string;
  label: string;
}

interface Props {
  items: OverviewItem[];
}

const { items } = Astro.props;
---

<section class="section-shell overview-section">
  <div class="section-heading">
    <p class="eyebrow" data-edit-key="home.overviewEyebrow">Overview</p>
    <h2 data-edit-key="home.overviewTitle">Overview Directory</h2>
    <p data-edit-key="home.overviewSummary">Feel free to explore my website!</p>
  </div>
  <div class="overview-grid">
    {
      items.map((item) => (
        <article class="overview-card">
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <a href={item.href}>{item.label}</a>
        </article>
      ))
    }
  </div>
</section>
