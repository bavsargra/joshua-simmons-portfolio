---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import PageIntro from "@components/PageIntro.astro";
import ProjectGrid from "@components/ProjectGrid.astro";
import Contact from "@components/Contact.astro";
import site from "@data/site.json";
---

<BaseLayout title={`Projects | ${site.profile.name}`} description="Analytics projects and portfolio work by Joshua Simmons.">
  <Header name={site.profile.name} nav={site.nav} portraitSrc={site.profile.portraitSrc} />
  <main class="projects-page">
    <PageIntro
      eyebrow="Projects"
      title="Hands On Analytics Projects"
      summary="My past projects, case work, research, and future project portfolio pieces!"
      keyPrefix="projects.pageIntro"
    />
    <section class="section-shell">
      <ProjectGrid projects={site.projects} />
    </section>
    <Contact profile={site.profile} links={site.links} />
  </main>
</BaseLayout>
