---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import site from "@data/site.json";

interface ProjectGalleryItem {
  src: string;
  alt: string;
  caption?: string;
}

interface ProjectReferenceItem {
  title: string;
  href: string;
  detail?: string;
}

interface Project {
  slug: string;
  title: string;
  category: string;
  summary: string;
  detailSummary?: string;
  tags: string[];
  link: string;
  image?: string;
  metrics?: { value: string; label: string }[];
  insights?: string[];
  galleryTitle?: string;
  gallerySummary?: string;
  gallery?: ProjectGalleryItem[];
  references?: ProjectReferenceItem[];
}

export function getStaticPaths() {
  return site.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props as { project: Project };
const hasGallery = Array.isArray(project.gallery) && project.gallery.length > 0;
---

<BaseLayout title={`${project.title} | ${site.profile.name}`} description={project.detailSummary ?? project.summary}>
  <Header name={site.profile.name} nav={site.nav} portraitSrc={site.profile.portraitSrc} />
  <main class={`project-detail-page project-${project.slug}`}>
    <section class="project-detail-hero section-shell">
      <div class="project-detail-copy">
        <p class="eyebrow">{project.category}</p>
        <h1>{project.title}</h1>
        <p class="project-detail-summary">{project.detailSummary ?? project.summary}</p>
        <ul class="tag-list">
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {
          project.metrics && project.metrics.length > 0 && (
            <div class="project-metrics">
              {project.metrics.map((metric) => (
                <div class="project-metric">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </div>
              ))}
            </div>
          )
        }
        {
          project.insights && project.insights.length > 0 && (
            <ul class="project-insights">
              {project.insights.map((insight) => <li>{insight}</li>)}
            </ul>
          )
        }
        <div class="actions">
          <a class="button primary" href="/projects/">Back to projects</a>
          <a class="button secondary" href="/contact/">Ask about this work</a>
        </div>
      </div>
      {
        project.image && (
          <figure class="project-detail-feature">
            <img src={project.image} alt={project.title} />
          </figure>
        )
      }
    </section>

    {
      hasGallery ? (
        <section class="section-shell project-gallery-section">
          <div class="section-heading">
            <p class="eyebrow">Gallery</p>
            <h2>{project.galleryTitle ?? "Photos from the event and award."}</h2>
            <p>{project.gallerySummary ?? "A closer look at the team, the presentation setup, the modeling work, and the recognition from the event."}</p>
          </div>

          <div class="project-gallery-grid">
            {project.gallery?.map((item, index) => (
              <figure class={`project-gallery-item${index === 0 ? " featured" : ""}`}>
                <img src={item.src} alt={item.alt} loading="lazy" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      ) : (
        <section class="section-shell project-gallery-section">
          <div class="section-heading">
            <p class="eyebrow">More Soon</p>
            <h2>This project is ready for a custom gallery next.</h2>
            <p>The detail page is live, and more visuals or artifacts can be dropped in here whenever you want to expand it.</p>
          </div>
        </section>
      )
    }

    {
      project.references && project.references.length > 0 && (
        <section class="section-shell project-reference-section">
          <div class="section-heading">
            <p class="eyebrow">References</p>
            <h2>Source material and dataset context.</h2>
            <p>Key references used to frame the project and document the public context behind the work.</p>
          </div>

          <div class="project-reference-list">
            {project.references.map((reference) => (
              <article class="project-reference-item">
                <h3>{reference.title}</h3>
                {reference.detail && <p>{reference.detail}</p>}
                <a href={reference.href} target="_blank" rel="noreferrer">Open source</a>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
