---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import PageIntro from "@components/PageIntro.astro";
import TutoringSection from "@components/Tutoring.astro";
import Contact from "@components/Contact.astro";
import site from "@data/site.json";
---

<BaseLayout title={`Tutoring | ${site.profile.name}`} description="Tutoring services from Joshua Simmons.">
  <Header name={site.profile.name} nav={site.nav} portraitSrc={site.profile.portraitSrc} />
  <main class="tutoring-page">
    <PageIntro
      eyebrow="Tutoring"
      title="Songyu Tutoring"
      summary="A dedicated tutoring page for undergraduate/graduate students who want calm, practical help with assignments, concepts, and study methodologies."
      keyPrefix="tutoring.pageIntro"
    />
    <section class="section-shell warm-band">
      <TutoringSection tutoring={site.tutoring} email={site.profile.email} />
    </section>
    <Contact profile={site.profile} links={site.links} />
  </main>
</BaseLayout>
